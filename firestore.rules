rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// REGLAS DE SEGURIDAD DE CONFIX — son la "validación del servidor".
// Todo lo que no está permitido acá, queda DENEGADO.
// Roles: cliente | profesional (requiere aprobación) | admin (custom claim `admin: true`).
//
// Colecciones:
//   users/{uid}           perfil (role, status). El rol y el estado NO los puede cambiar el usuario.
//   professionals/{uid}   perfil público del profesional (id = uid; los de demo sin cuenta usan un id propio).
//                         Solo se ven los aprobados (estado = 'aprobado').
//   requests/{id}         solicitudes de cotización (cliente → profesional). Las ven el cliente, el profesional y el admin.
//   categories/{id}       catálogo de categorías (lectura pública, escribe el admin)
//   barrios/{nombre}      catálogo de barrios (lectura pública, escribe el admin)
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    // Admin = custom claim (scripts/admin-dar.ts, para los admins iniciales) o role 'admin' en users/{uid}. Un usuario no puede ponérselo.
    function isAdmin() { return signedIn() && (request.auth.token.admin == true || isAdminDoc()); }
    // Admin "de la app": un admin ya existente le dio role 'admin' en users/{uid} (pantalla Administradores).
    // Solo un admin puede escribir ese rol (ver reglas de users): nadie se lo puede poner solo.
    function isAdminDoc() { return exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'activo'; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function hasUserDoc(uid) { return exists(/databases/$(database)/documents/users/$(uid)); }
    function isActive() { return signedIn() && hasUserDoc(request.auth.uid) && userDoc(request.auth.uid).status == 'activo'; }
    function hasRole(role) { return isActive() && userDoc(request.auth.uid).role == role; }
    function onlyKeys(keys) { return request.resource.data.keys().hasOnly(keys); }
    function hasKeys(keys) { return request.resource.data.keys().hasAll(keys); }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function entero(v, min, max) { return v is int && v >= min && v <= max; }
    // Estado del perfil profesional ↔ estado del usuario (los dos se cambian juntos, en un batch).
    function estadoUsuarioDe(estadoPerfil) {
      return estadoPerfil == 'aprobado' ? 'activo' : estadoPerfil;
    }

    // ── users/{uid} ────────────────────────────────────────────────────────
    // Cada uno lee su perfil; el admin lee y gestiona todos.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Alta: solo el propio usuario, solo roles registrables, y el estado inicial queda fijado por el rol
      // (cliente → activo; profesional → pendiente hasta que el admin lo apruebe). NUNCA con role 'admin'.
      allow create: if isOwner(uid)
        && onlyKeys(['email', 'displayName', 'role', 'status', 'isDemo', 'createdAt'])
        && hasKeys(['email', 'displayName', 'role', 'status', 'isDemo', 'createdAt'])
        && str(request.resource.data.displayName, 2, 80)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.isDemo == false
        && request.resource.data.createdAt == request.time
        && ((request.resource.data.role == 'cliente' && request.resource.data.status == 'activo')
         || (request.resource.data.role == 'profesional' && request.resource.data.status == 'pendiente'));

      allow update:
        // El dueño solo puede cambiar su nombre. role y status están vedados (no hay escalada).
        if (isOwner(uid)
          && changedOnly(['displayName'])
          && str(request.resource.data.displayName, 2, 80))
        // El admin cambia el estado (activo / pendiente / suspendido), nunca el rol.
        // Si es un profesional con perfil, el perfil tiene que cambiar en el mismo batch al estado equivalente.
        || (isAdmin()
          && changedOnly(['status', 'displayName'])
          && request.resource.data.status in ['activo', 'pendiente', 'suspendido']
          && (resource.data.role != 'profesional'
            || !existsAfter(/databases/$(database)/documents/professionals/$(uid))
            || estadoUsuarioDe(getAfter(/databases/$(database)/documents/professionals/$(uid)).data.estado) == request.resource.data.status));

      // Dar y quitar el rol de admin: solo un admin, solo sobre OTRA persona, y solo cambia `role`.
      // Los superadmins (campo `superadmin: true`, solo se escribe con el Admin SDK) quedan protegidos.
      // Se puede promover a alguien con la cuenta activa; al quitar el rol vuelve a ser 'cliente'.
      allow update: if isAdmin()
        && uid != request.auth.uid
        && resource.data.get('superadmin', false) != true // superadmins de la cátedra: nadie les quita el rol
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && ((request.resource.data.role == 'admin' && resource.data.role != 'admin' && resource.data.status == 'activo')
         || (resource.data.role == 'admin' && request.resource.data.role == 'cliente'));

      allow delete: if false;
    }

    // ── categories/{id} y barrios/{nombre} ─────────────────────────────────
    match /categories/{id} {
      allow read: if true;
      allow create: if isAdmin()
        && id.matches('^[a-z0-9-]{3,30}$')
        && onlyKeys(['nombre', 'descripcion', 'orden', 'activa'])
        && hasKeys(['nombre', 'descripcion', 'orden', 'activa'])
        && str(request.resource.data.nombre, 3, 40)
        && str(request.resource.data.descripcion, 0, 100)
        && entero(request.resource.data.orden, 0, 1000)
        && request.resource.data.activa is bool;
      allow update: if isAdmin()
        && changedOnly(['nombre', 'descripcion', 'orden', 'activa'])
        && str(request.resource.data.nombre, 3, 40)
        && str(request.resource.data.descripcion, 0, 100)
        && entero(request.resource.data.orden, 0, 1000)
        && request.resource.data.activa is bool;
      allow delete: if false;
    }
    match /barrios/{nombre} {
      allow read: if true;
      allow create: if isAdmin()
        && onlyKeys(['nombre', 'orden', 'activo'])
        && hasKeys(['nombre', 'orden', 'activo'])
        && request.resource.data.nombre == nombre
        && str(nombre, 3, 40)
        && entero(request.resource.data.orden, 0, 1000)
        && request.resource.data.activo is bool;
      allow update: if isAdmin()
        && changedOnly(['orden', 'activo'])
        && entero(request.resource.data.orden, 0, 1000)
        && request.resource.data.activo is bool;
      allow delete: if false;
    }

    // ── professionals/{id} ─────────────────────────────────────────────────
    // Un servicio del profesional: { id, nombre, detalle, precio, unidad }.
    function servicioOk(s) {
      return s is map && s.size() == 5 && s.keys().hasOnly(['id', 'nombre', 'detalle', 'precio', 'unidad'])
        && s.id is string && s.id.size() >= 1 && s.id.size() <= 20
        && s.nombre is string && s.nombre.size() >= 3 && s.nombre.size() <= 60
        && s.detalle is string && s.detalle.size() <= 100
        && s.precio is int && s.precio >= 100 && s.precio <= 5000000
        && s.unidad is string && s.unidad.size() >= 1 && s.unidad.size() <= 30;
    }
    // Las reglas no tienen bucles y Firestore corta a las 1000 expresiones evaluadas: se revisan hasta 5 posiciones.
    function servicioEn(l, i) { return l.size() <= i || servicioOk(l[i]); }
    function serviciosOk(l) {
      return l is list && l.size() >= 1 && l.size() <= 5
        && servicioEn(l, 0) && servicioEn(l, 1) && servicioEn(l, 2) && servicioEn(l, 3) && servicioEn(l, 4);
    }
    // Campos que el profesional puede escribir sobre su perfil.
    function perfilEditableOk(d) {
      return str(d.nombre, 3, 60)
        && d.categoria is string && exists(/databases/$(database)/documents/categories/$(d.categoria))
        && str(d.oficio, 3, 40)
        && d.barrio is string && exists(/databases/$(database)/documents/barrios/$(d.barrio))
        && str(d.horario, 3, 40)
        && entero(d.costoVisita, 0, 100000)
        && str(d.descripcion, 20, 600)
        && serviciosOk(d.servicios);
    }
    function esProfesionalNoSuspendido() {
      return signedIn() && hasUserDoc(request.auth.uid)
        && userDoc(request.auth.uid).role == 'profesional'
        && userDoc(request.auth.uid).status in ['activo', 'pendiente'];
    }

    match /professionals/{id} {
      // Lo aprobado es público (se puede buscar sin cuenta); lo demás solo lo ve su dueño o el admin.
      // (Si el documento todavía no existe, su futuro dueño puede consultarlo: así sabe que le falta crearlo.)
      allow read: if resource == null
        ? (isOwner(id) || isAdmin())
        : (resource.data.estado == 'aprobado' || isOwner(resource.data.ownerId) || isAdmin());

      // Alta: el propio profesional (con cuenta de tipo profesional), siempre PENDIENTE, y con las
      // estadísticas en cero: puntaje, reseñas y trabajos no los puede inventar.
      allow create: if isOwner(id) && esProfesionalNoSuspendido()
        && onlyKeys(['ownerId', 'nombre', 'categoria', 'oficio', 'descripcion', 'barrio', 'horario', 'costoVisita', 'servicios',
                     'foto', 'puntaje', 'cantidadResenas', 'distanciaKm', 'dias', 'anosExperiencia', 'trabajosRealizados',
                     'respuesta', 'resenas', 'disponibleHoy', 'estado', 'isDemo', 'createdAt'])
        && hasKeys(['ownerId', 'nombre', 'categoria', 'oficio', 'descripcion', 'barrio', 'horario', 'costoVisita', 'servicios',
                    'foto', 'puntaje', 'cantidadResenas', 'distanciaKm', 'dias', 'anosExperiencia', 'trabajosRealizados',
                    'respuesta', 'resenas', 'disponibleHoy', 'estado', 'isDemo', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.isDemo == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.foto == ''
        && request.resource.data.puntaje == 0
        && request.resource.data.cantidadResenas == 0
        && request.resource.data.distanciaKm == 2.5
        && request.resource.data.dias == ['Lun', 'Mar', 'Mié', 'Jue', 'Vie']
        && request.resource.data.anosExperiencia == 0
        && request.resource.data.trabajosRealizados == 0
        && request.resource.data.respuesta == 'Nuevo en CONFIX'
        && request.resource.data.resenas == []
        && request.resource.data.disponibleHoy == true
        && perfilEditableOk(request.resource.data);

      allow update:
        // El dueño edita solo los datos de su perfil (no el estado, ni las estadísticas, ni las reseñas).
        if (isOwner(resource.data.ownerId) && esProfesionalNoSuspendido()
          && changedOnly(['nombre', 'categoria', 'oficio', 'descripcion', 'barrio', 'horario', 'costoVisita', 'servicios'])
          && perfilEditableOk(request.resource.data))
        // El admin aprueba / suspende. Si el profesional tiene cuenta, su usuario cambia en el mismo batch.
        || (isAdmin()
          && changedOnly(['estado'])
          && request.resource.data.estado in ['aprobado', 'pendiente', 'suspendido']
          && (!existsAfter(/databases/$(database)/documents/users/$(resource.data.ownerId))
            || getAfter(/databases/$(database)/documents/users/$(resource.data.ownerId)).data.status == estadoUsuarioDe(request.resource.data.estado)));

      allow delete: if false;
    }

    // ── requests/{id} ──────────────────────────────────────────────────────
    // Un ítem pedido: { nombre, precio, cantidad }.
    function lineaOk(it) {
      return it is map && it.size() == 3 && it.keys().hasOnly(['nombre', 'precio', 'cantidad'])
        && it.nombre is string && it.nombre.size() <= 60
        && it.precio is int && it.precio >= 100 && it.precio <= 5000000
        && it.cantidad is int && it.cantidad >= 1 && it.cantidad <= 10;
    }
    function lineaEn(l, i) { return l.size() <= i || lineaOk(l[i]); }
    function itemsOk(l) {
      return l is list && l.size() >= 1 && l.size() <= 5
        && lineaEn(l, 0) && lineaEn(l, 1) && lineaEn(l, 2) && lineaEn(l, 3) && lineaEn(l, 4);
    }
    function subtotalEn(l, i) { return l.size() <= i ? 0 : l[i].precio * l[i].cantidad; }
    function subtotal(l) {
      return subtotalEn(l, 0) + subtotalEn(l, 1) + subtotalEn(l, 2) + subtotalEn(l, 3) + subtotalEn(l, 4);
    }
    function profesional(id) { return get(/databases/$(database)/documents/professionals/$(id)).data; }

    // Validación de una solicitud nueva contra el perfil del profesional elegido (se lee una sola vez).
    function solicitudOk(d) {
      let p = get(/databases/$(database)/documents/professionals/$(d.professionalId)).data;
      return p.estado == 'aprobado'
        && d.professionalOwnerId == p.ownerId
        && d.professionalNombre == p.nombre
        && d.costoVisita == p.costoVisita
        && d.total == d.costoVisita + subtotal(d.items);
    }

    match /requests/{id} {
      // Las ve el cliente que la pidió, el profesional destinatario y el admin (el teléfono viaja acá).
      allow read: if isOwner(resource.data.clientId) || isOwner(resource.data.professionalOwnerId) || isAdmin();

      // Solo un CLIENTE activo, a su nombre, hacia un profesional APROBADO, siempre en estado 'pendiente'.
      // El total se recalcula acá: ítems + visita del profesional.
      allow create: if hasRole('cliente')
        && onlyKeys(['clientId', 'professionalId', 'professionalOwnerId', 'professionalNombre', 'items', 'direccion', 'piso', 'barrio',
                     'fecha', 'franja', 'notas', 'contactoNombre', 'contactoTelefono', 'costoVisita', 'total', 'estado', 'isDemo', 'createdAt'])
        && hasKeys(['clientId', 'professionalId', 'professionalOwnerId', 'professionalNombre', 'items', 'direccion', 'piso', 'barrio',
                    'fecha', 'franja', 'notas', 'contactoNombre', 'contactoTelefono', 'costoVisita', 'total', 'estado', 'isDemo', 'createdAt'])
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.isDemo == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.professionalId is string
        && exists(/databases/$(database)/documents/professionals/$(request.resource.data.professionalId))
        && itemsOk(request.resource.data.items)
        && solicitudOk(request.resource.data)
        && str(request.resource.data.direccion, 4, 160)
        && str(request.resource.data.piso, 0, 30)
        && str(request.resource.data.barrio, 3, 40)
        && str(request.resource.data.fecha, 1, 80)
        && str(request.resource.data.franja, 1, 60)
        && str(request.resource.data.notas, 0, 500)
        && str(request.resource.data.contactoNombre, 3, 80)
        && str(request.resource.data.contactoTelefono, 8, 30);

      // Solo cambia el estado:
      //  · el cliente puede cancelar mientras está pendiente o aceptada;
      //  · el profesional destinatario: pendiente → aceptada / rechazada; aceptada → completada / rechazada.
      allow update: if changedOnly(['estado']) && (
        (hasRole('cliente') && isOwner(resource.data.clientId)
          && resource.data.estado in ['pendiente', 'aceptada']
          && request.resource.data.estado == 'cancelada')
        || (hasRole('profesional') && isOwner(resource.data.professionalOwnerId)
          && ((resource.data.estado == 'pendiente' && request.resource.data.estado in ['aceptada', 'rechazada'])
           || (resource.data.estado == 'aceptada' && request.resource.data.estado in ['completada', 'rechazada']))));

      allow delete: if false;
    }
  }
}
