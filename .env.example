# Copiá este archivo a .env y completá tus valores. No subas .env al repo.
# La app valida estas variables al arrancar y te dice cuál falta.

# --- Obligatorias ---

# Conexión a Postgres (Neon u otra). Formato: postgresql://usuario:clave@host/base?sslmode=require
DATABASE_URL=

# Secreto de Better Auth (mínimo 32 caracteres). Generá uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL pública de la app, sin barra final (en local: http://localhost:3000).
# En producción: https://tu-dominio. Tiene que coincidir con la que cargues en Google.
BETTER_AUTH_URL=http://localhost:3000

# --- Administración ---

# Emails que son administradores, separados por coma.
# - `npm run db:admins` crea/promueve esas cuentas (usa ADMIN_INITIAL_PASSWORD, ver abajo).
# - Si inician sesión con Google (email verificado), también quedan como admin.
# El registro con email y contraseña NUNCA da rol admin.
ADMIN_EMAILS=

# Contraseña inicial que usa `npm run db:admins` para las cuentas que todavía no existen
# (mínimo 8 caracteres). Solo la lee ese script; cambiala después de ingresar.
ADMIN_INITIAL_PASSWORD=

# --- Google OAuth (opcional) ---

# Si dejás estas dos vacías, el botón de Google se reemplaza por un aviso.
# Redirect URI a cargar en Google Cloud: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
